{
  "name": "netivo/woocommerce",
  "description": "WP Core Library for Netivo themes to support WooCommerce",
  "minimum-stability": "stable",
  "license": "proprietary",
  "version": "1.1",
  "authors": [
    {
      "name": "netivo",
      "email": "biuro@netivo.pl"
    },
    {
      "name": "Michał Świątek",
      "email": "michal.swiatek@netivo.pl"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:netivo/wp-core.git"
    }
  ],
  "require": {
    "php": ">=8.4",
    "netivo/wp-core": "^1.1.1"
  },
  "autoload": {
    "psr-4": {
      "Netivo\\WooCommerce\\": "src/"
    }
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/php-compatibility": "^9.3"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist -d memory_limit=1024M --runtime-set timeout 300",
    "lint:fix": "phpcbf --standard=phpcs.xml.dist -d memory_limit=1024M --runtime-set timeout 300"
  }
}
